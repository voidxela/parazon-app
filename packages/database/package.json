{
  "name": "@parazon/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema/index.js",
      "types": "./dist/schema/index.d.ts"
    },
    "./migrate": {
      "import": "./dist/migrate.js",
      "types": "./dist/migrate.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate:users": "drizzle-kit generate --config drizzle.config.users.ts",
    "db:generate:cache": "drizzle-kit generate --config drizzle.config.cache.ts",
    "db:generate:vector": "drizzle-kit generate --config drizzle.config.vector.ts",
    "db:generate": "pnpm db:generate:users && pnpm db:generate:cache && pnpm db:generate:vector",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.38.3",
    "libsql": "^0.5.29",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@parazon/typescript-config": "workspace:*",
    "@types/node": "^22.19.19",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
